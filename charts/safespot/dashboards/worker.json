{
  "title": "SafeSpot Worker",
  "uid": "safespot-worker",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "Pod Running Count",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "count(kube_pod_status_phase{phase=\"Running\", namespace=\"worker\"})",
          "legendFormat": "Running Pods"
        }
      ]
    },
    {
      "id": 2,
      "title": "Pod Restart Count",
      "type": "stat",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "options": {
        "colorMode": "background",
        "thresholds": {
          "steps": [
            { "color": "green", "value": 0 },
            { "color": "red", "value": 1 }
          ]
        }
      },
      "targets": [
        {
          "expr": "sum(kube_pod_container_status_restarts_total{namespace=\"worker\"}) by (pod)",
          "legendFormat": "{{ pod }}"
        }
      ]
    },
    {
      "id": 3,
      "title": "CPU Usage by Pod",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"worker\", container!=\"\"}[1m])) by (pod)",
          "legendFormat": "{{ pod }}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Memory Usage by Pod",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{namespace=\"worker\", container!=\"\"}) by (pod)",
          "legendFormat": "{{ pod }}"
        }
      ]
    },
    {
      "id": 5,
      "title": "SQS Messages Received/s",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(sqs_messages_received_total{namespace=\"worker\"}[1m])",
          "legendFormat": "{{ queue }}"
        }
      ]
    },
    {
      "id": 6,
      "title": "SQS Message Processing Errors/s",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(sqs_messages_failed_total{namespace=\"worker\"}[1m])",
          "legendFormat": "{{ queue }}"
        }
      ]
    }
  ]
}