{
  "title": "SafeSpot JVM",
  "uid": "safespot-jvm",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "Heap Memory Used vs Max",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{area=\"heap\"}) by (pod)",
          "legendFormat": "Used {{ pod }}"
        },
        {
          "expr": "sum(jvm_memory_max_bytes{area=\"heap\"}) by (pod)",
          "legendFormat": "Max {{ pod }}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Heap Usage %",
      "type": "gauge",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "options": {
        "thresholds": {
          "steps": [
            { "color": "green", "value": 0 },
            { "color": "yellow", "value": 70 },
            { "color": "red", "value": 85 }
          ]
        }
      },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{area=\"heap\"}) by (pod) / sum(jvm_memory_max_bytes{area=\"heap\"}) by (pod) * 100",
          "legendFormat": "{{ pod }}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Non-Heap Memory Used",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{area=\"nonheap\"}) by (pod)",
          "legendFormat": "{{ pod }}"
        }
      ]
    },
    {
      "id": 4,
      "title": "GC Pause Average (s)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(jvm_gc_pause_seconds_sum[1m]) / rate(jvm_gc_pause_seconds_count[1m])",
          "legendFormat": "{{ pod }} {{ action }}"
        }
      ]
    },
    {
      "id": 5,
      "title": "GC Count/s",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(jvm_gc_pause_seconds_count[1m])",
          "legendFormat": "{{ pod }} {{ cause }}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Active Threads",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "jvm_threads_live_threads",
          "legendFormat": "Live {{ pod }}"
        },
        {
          "expr": "jvm_threads_daemon_threads",
          "legendFormat": "Daemon {{ pod }}"
        }
      ]
    }
  ]
}