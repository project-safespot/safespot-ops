{
  "title": "SafeSpot PostgreSQL",
  "uid": "safespot-postgres",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "Active Connections",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "pg_stat_activity_count{state=\"active\"}",
          "legendFormat": "Active"
        },
        {
          "expr": "pg_stat_activity_count{state=\"idle\"}",
          "legendFormat": "Idle"
        }
      ]
    },
    {
      "id": 2,
      "title": "Total Connections",
      "type": "gauge",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "options": {
        "thresholds": {
          "steps": [
            { "color": "green", "value": 0 },
            { "color": "yellow", "value": 60 },
            { "color": "red", "value": 80 }
          ]
        }
      },
      "targets": [
        {
          "expr": "pg_stat_activity_count",
          "legendFormat": "Total Connections"
        }
      ]
    },
    {
      "id": 3,
      "title": "Transactions/s",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(pg_stat_database_xact_commit{datname!~\"template.*|postgres\"}[1m])",
          "legendFormat": "Commit {{ datname }}"
        },
        {
          "expr": "rate(pg_stat_database_xact_rollback{datname!~\"template.*|postgres\"}[1m])",
          "legendFormat": "Rollback {{ datname }}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Deadlocks/s",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(pg_stat_database_deadlocks{datname!~\"template.*|postgres\"}[5m])",
          "legendFormat": "Deadlocks {{ datname }}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Cache Hit Ratio",
      "type": "gauge",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "options": {
        "thresholds": {
          "steps": [
            { "color": "red", "value": 0 },
            { "color": "yellow", "value": 90 },
            { "color": "green", "value": 99 }
          ]
        }
      },
      "targets": [
        {
          "expr": "pg_stat_database_blks_hit / (pg_stat_database_blks_hit + pg_stat_database_blks_read) * 100",
          "legendFormat": "Cache Hit %"
        }
      ]
    },
    {
      "id": 6,
      "title": "Rows Fetched/s vs Returned/s",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(pg_stat_database_tup_fetched{datname!~\"template.*|postgres\"}[1m])",
          "legendFormat": "Fetched {{ datname }}"
        },
        {
          "expr": "rate(pg_stat_database_tup_returned{datname!~\"template.*|postgres\"}[1m])",
          "legendFormat": "Returned {{ datname }}"
        }
      ]
    }
  ]
}